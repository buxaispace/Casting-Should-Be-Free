<?xml version="1.0" encoding="utf-8" ?>
<Project>
    <Target Name="RemoveMissingHintPathReferences" BeforeTargets="ResolveAssemblyReferences">
        <ItemGroup>
            <_MissingHintPathRef Include="@(Reference)" Condition="'%(Reference.HintPath)' != '' AND !Exists('%(Reference.HintPath)')"/>
            <Reference Remove="@(_MissingHintPathRef)"/>
        </ItemGroup>
    </Target>

    <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(CI)' != 'TRUE' AND Exists('$(PluginsPath)')">
        <ItemGroup>
            <FilesToCopy Include="$(TargetPath)"/>
            <FilesToCopy Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')"/>
        </ItemGroup>

        <Copy SourceFiles="@(FilesToCopy)" DestinationFiles="@(FilesToCopy->'$(PluginsPath)\$(ProjectName)\%(Filename)%(Extension)')"/>
        <Message Text="Copied $(TargetFileName) and $(TargetName).pdb to Plugins" Importance="high"/>
    </Target>
</Project>
