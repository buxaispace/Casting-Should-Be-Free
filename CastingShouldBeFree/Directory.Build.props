<?xml version="1.0" encoding="utf-8" ?>
<Project>
    <PropertyGroup>
        <GamePath>$(GorillaTag_GamePath)</GamePath>
        <GameAssemblyPath>$(GamePath)\Gorilla Tag_Data\Managed</GameAssemblyPath>
        <BepInExAssemblyPath>$(GamePath)\BepInEx\core</BepInExAssemblyPath>
        <PluginsPath>$(GamePath)\BepInEx\plugins</PluginsPath>
        <RestoreAdditionalProjectSources>https://api.nuget.org/v3/index.json;https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
    </PropertyGroup>
    <!-- Override managed-ref folder without changing the Windows GorillaTag_GamePath layout. -->
    <PropertyGroup Condition="'$(GTManagedPath)' != ''">
        <GameAssemblyPath>$(GTManagedPath)</GameAssemblyPath>
    </PropertyGroup>
    <PropertyGroup Condition="'$(BepInExPath)' != ''">
        <BepInExAssemblyPath>$(BepInExPath)</BepInExAssemblyPath>
    </PropertyGroup>
    <PropertyGroup Condition="'$(CI)'=='TRUE' AND '$(GTManagedPath)' == ''">
        <GameAssemblyPath>.\Libs</GameAssemblyPath>
        <BepInExAssemblyPath>.\Libs</BepInExAssemblyPath>
        <PluginsPath>.\Libs</PluginsPath>
        <WarningLevel>0</WarningLevel>
    </PropertyGroup>
</Project>
